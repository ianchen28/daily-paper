# LLM 配置
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
INCLUDE_REASONING=false

# 数据库配置
# SQLite (默认，自动创建 daily_paper.db)
# DATABASE_URL=daily_paper.db

# PostgreSQL (推荐用于生产环境和 RAG Agent 开发)
# DATABASE_URL=postgresql://username:password@localhost:5432/daily_paper

# 网页生成配置
# WEB_OUTPUT_DIR=web_reports

# 邮件配置
# Gmail 配置示例
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USE_TLS=true

# QQ 邮箱配置示例（二选一）
# SMTP_SERVER=smtp.qq.com
# SMTP_PORT=465
# SMTP_USE_SSL=true
# SMTP_USE_TLS=false

EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECEIVER=your_email@gmail.com
SMTP_TIMEOUT=30

# 论文配置
KEYWORDS=RAG, Agent, Multimodal, Efficient Training
MAX_PAPERS=6
